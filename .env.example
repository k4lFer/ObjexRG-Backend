# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_NAME=objexrg_credentials
DATABASE_URL=host=localhost user=postgres password=your-secure-password dbname=objexrg_credentials port=5432 sslmode=disable

# Storage Configuration
# Path only used when STORAGE_DRIVER=local.
OBJEXRG_STORAGE_PATH=./data

# Storage driver: local | s3  (s3 = RustFS, see docker-compose.yml)
# s3 stores blobs in RustFS; data/ is unused in that mode.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=objexrg
S3_REGION=us-east-1
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
PRESIGN_TTL=15m

# JWT Configuration
JWT_ACCESS_SECRET=your-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-secret-key-here-change-in-production

# Base URL for public/share links (absolute, no trailing slash)
PUBLIC_BASE_URL=http://localhost:7080
